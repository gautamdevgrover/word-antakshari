{
  "name": "word-antakshari-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit",
