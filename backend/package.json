    "an-array-of-english-words": "^2.0.0",
    "dotenv": "^17.0.0",
    "express": "5.2.1",
    "redis": "6.2.1",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "prisma": "7.10.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
